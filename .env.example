# Copy this file to .env for local development: cp .env.example .env
# Replace every "change-me" value before any non-local deployment.

# --- Application ---
APP_NAME=YouTube Clone
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
MAX_VIDEO_SIZE_BYTES=2147483648
UPLOAD_URL_TTL_SECONDS=3600
PLAYBACK_URL_TTL_SECONDS=21600
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# --- JWT (access 15 min, refresh 7 days) ---
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL (localhost values are for running the app outside Docker;
#     docker-compose overrides DATABASE_URL/host to the postgres service) ---
POSTGRES_DB=youtube
POSTGRES_USER=youtube
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://youtube:change-me-postgres@localhost:5432/youtube

# --- Redis / ARQ ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 (MINIO_ACCESS_KEY/SECRET_KEY are the app credentials;
#     keep them in sync with MINIO_ROOT_USER/MINIO_ROOT_PASSWORD locally) ---
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:8000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=youtube
MINIO_SECURE=false